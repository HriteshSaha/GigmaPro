{
  "name": "gigmapro",
  "version": "1.0.0",
  "description": "GigmaPro is a full-stack freelance marketplace where clients post projects and freelancers bid on them, built with Express, EJS and MySQL (Sequelize).",
  "main": "app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "db:setup": "npm run migrate && npm run seed",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "gigmapro",
    "freelancing",
    "gig",
    "project",
    "bidding",
    "express",
    "sequelize"
  ],
  "author": "Hritesh Saha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HriteshSaha/GigmaPro.git"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "mysql2": "^3.11.3",
    "sequelize": "^6.37.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "sequelize-cli": "^6.6.5"
  }
}
