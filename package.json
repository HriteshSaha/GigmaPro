{
  "name": "gigmapro",
  "version": "1.0.0",
  "description": "GigmaPro is a full-stack freelance marketplace where clients post projects and freelancers bid on them, built with Express, EJS and PostgreSQL (Sequelize).",
  "main": "app.js",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "migrate": "sequelize-cli db:migrate",
    "migrate:undo": "sequelize-cli db:migrate:undo:all",
    "seed": "sequelize-cli db:seed:all",
    "seed:undo": "sequelize-cli db:seed:undo:all",
    "db:setup": "npm run migrate && npm run seed",
    "migrate:test": "cross-env NODE_ENV=test sequelize-cli db:migrate",
    "test": "cross-env NODE_ENV=test jest --runInBand"
  },
  "keywords": [
    "gigmapro",
    "freelancing",
    "gig",
    "project",
    "bidding",
    "express",
    "sequelize"
  ],
  "author": "Hritesh Saha",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/HriteshSaha/GigmaPro.git"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.5",
    "ejs": "^3.1.10",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.3",
    "sequelize-cli": "^6.6.5"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.0"
  }
}
