NODE_ENV=development
PORT=8000

# Local MySQL connection (used in development)
DB_USER=root
DB_PASSWORD=
DB_NAME=gigmapro
DB_HOST=127.0.0.1
DB_PORT=3306

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set DB_SSL=true if your production MySQL provider requires SSL
DB_SSL=false

# Production only: a single connection string (Railway/Render provide this automatically)
# DATABASE_URL=mysql://user:password@host:port/database
