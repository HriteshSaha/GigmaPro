NODE_ENV=development
PORT=8000

# Local PostgreSQL connection (used in development)
DB_USER=postgres
DB_PASSWORD=
DB_NAME=gigmapro
# Used by `npm test` (NODE_ENV=test) — a separate database so tests never touch dev data
DB_NAME_TEST=gigmapro_test
DB_HOST=127.0.0.1
DB_PORT=5432

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Set DB_SSL=true if your production Postgres provider requires SSL (e.g. an external Render connection)
DB_SSL=false

# Production only: a single connection string (Render/Railway provide this automatically)
# DATABASE_URL=postgres://user:password@host:port/database
