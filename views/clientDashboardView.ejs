<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta content="width=device-width, initial-scale=1.0" name="viewport">

  <title>Dashboard - <%= firstName %></title>
  <meta content="" name="description">
  <meta content="" name="keywords">

  <!-- Favicons -->
  <link href="/assets-dashboard/img/favicon.png" rel="icon">
  <link href="/assets-dashboard/img/apple-touch-icon.png" rel="apple-touch-icon">

  <!-- Google Fonts -->
  <link href="https://fonts.gstatic.com" rel="preconnect">
  <link href="https://fonts.googleapis.com/css?family=Open+Sans:300,300i,400,400i,600,600i,700,700i|Nunito:300,300i,400,400i,600,600i,700,700i|Poppins:300,300i,400,400i,500,500i,600,600i,700,700i" rel="stylesheet">

  <!-- Vendor CSS Files -->
  <link href="/assets-dashboard/vendor/bootstrap/css/bootstrap.min.css" rel="stylesheet">
  <link href="/assets-dashboard/vendor/bootstrap-icons/bootstrap-icons.css" rel="stylesheet">
  <link href="/assets-dashboard/vendor/boxicons/css/boxicons.min.css" rel="stylesheet">
  <link href="/assets-dashboard/vendor/quill/quill.snow.css" rel="stylesheet">
  <link href="/assets-dashboard/vendor/quill/quill.bubble.css" rel="stylesheet">
  <link href="/assets-dashboard/vendor/remixicon/remixicon.css" rel="stylesheet">
  <link href="/assets-dashboard/vendor/simple-datatables/style.css" rel="stylesheet">

  <!-- Template Main CSS File -->
  <link href="/assets-dashboard/css/style.css" rel="stylesheet">

  <style>
    .status-badge {
      display: inline-block;
      font-size: 0.7rem;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 20px;
      margin-left: 8px;
      vertical-align: middle;
    }
    .status-badge.open { background: #e6f7ee; color: #1e7e34; }
    .status-badge.closed { background: #eef1ff; color: #37517E; }
    .empty-card {
      text-align: center;
      padding: 50px 20px;
      color: #6c757d;
    }
    .empty-card i { font-size: 2.2rem; margin-bottom: 10px; display: block; }
    .empty-card a { color: #4154f1; font-weight: 600; }
  </style>
</head>

<body>

  <!-- ======= Header ======= -->
  <header id="header" class="header fixed-top d-flex align-items-center">

    <div class="d-flex align-items-center justify-content-between">
      <a href="/">
        <img src="/assets/img/GigmaProLogo.png" alt="GigmaPro" id="gigmaLogo" style="width: 50%; height: auto;">
      </a>
      <i class="bi bi-list toggle-sidebar-btn"></i>
    </div><!-- End Logo -->

    <nav class="header-nav ms-auto">
      <ul class="d-flex align-items-center">

        <li class="nav-item dropdown pe-3">

          <a class="nav-link nav-profile d-flex align-items-center pe-0" href="#" data-bs-toggle="dropdown">
            <img src="/assets-dashboard/img/profile-img.jpg" alt="Profile" class="rounded-circle">
            <span class="d-none d-md-block dropdown-toggle ps-2"><%=firstName+ ' '+ lastName %></span>
          </a><!-- End Profile Iamge Icon -->

          <ul class="dropdown-menu dropdown-menu-end dropdown-menu-arrow profile">
            <li class="dropdown-header">
              <h6><%=firstName%></h6>
              <span>Client</span>
            </li>
            <li>
              <hr class="dropdown-divider">
            </li>

            <li>
              <a class="dropdown-item d-flex align-items-center" href="/logout">
                <i class="bi bi-box-arrow-right"></i>
                <span>Sign Out</span>
              </a>
            </li>

          </ul><!-- End Profile Dropdown Items -->
        </li><!-- End Profile Nav -->

      </ul>
    </nav><!-- End Icons Navigation -->

  </header><!-- End Header -->

  <!-- ========================= Sidebar ================================ -->
  <aside id="sidebar" class="sidebar">

    <ul class="sidebar-nav" id="sidebar-nav">

      <li class="nav-item">
        <a class="nav-link " href="/client/dashboard">
          <i class="bi bi-grid"></i>
          <span>Dashboard</span>
        </a>
      </li><!-- End Dashboard Nav -->

      <li class="nav-item">
        <a class="nav-link collapsed" href="/client/create-project">
          <i class="bi bi-plus-circle"></i>
          <span>Post a Project</span>
        </a>
      </li><!-- End Post Project Nav -->

      <li class="nav-item">
        <a class="nav-link collapsed" href="/">
          <i class="bi bi-house"></i>
          <span>Home</span>
        </a>
      </li><!-- End Home Nav -->

      <li class="nav-item">
        <a class="nav-link collapsed" href="/logout">
          <i class="bi bi-box-arrow-in-right"></i>
          <span>Logout</span>
        </a>
      </li><!-- End Logout Nav -->
    </ul>
  </aside><!-- End Sidebar-->

  <main id="main" class="main">

    <div class="pagetitle">
      <h1>Welcome <%= firstName %></h1>
      <p>Dashboard</p>
      <div class="button-container">
        <a href="/client/create-project" class="add-project-btn"> Add a Project </a>
      </div>
    </div><!-- End Page Title -->

    <section class="section dashboard">
      <div class="row">

        <!-- Left side columns -->
        <div class="col-lg-8">
          <div class="row">

            <% if (projects.length === 0) { %>
              <div class="col-12">
                <div class="card">
                  <div class="empty-card">
                    <i class="bi bi-folder2-open"></i>
                    <p class="mb-1">You haven't posted any projects yet.</p>
                    <a href="/client/create-project">Post your first project &rarr;</a>
                  </div>
                </div>
              </div>
            <% } %>

            <% projects.forEach((project)=>{%>
            <div class="col-12">
              <div class="card top-selling overflow-auto">

                <div class="card-body pb-0">
                  <h5 class="card-title">
                    <%= project.title %>
                    <span class="status-badge <%= project.status %>"><%= project.status %></span>
                    <span>| <%= new Date(project.createdAt).toLocaleDateString()%> </span>
                  </h5>

                  <table class="table table-borderless">
                    <thead>
                      <tr>
                        <th scope="col">Freelancers</th>
                        <th scope="col">Date of delivery</th>
                        <th scope="col">Quotation</th>
                        <th scope="col"></th>
                      </tr>
                    </thead>
                    <tbody>
                      <% if (project.projectBids && project.projectBids.length > 0) { %>
                        <% project.projectBids.forEach((bid) => { %>
                          <tr>
                            <td><a href="#" class="text-primary fw-bold"><%= bid.freelancer ? bid.freelancer.firstName : 'Unknown' %></a></td>
                            <td><%= bid.estimatedDateOfDelivery ? new Date(bid.estimatedDateOfDelivery).toLocaleDateString() : 'N/A' %></td>
                            <td class="fw-bold">₹ <%= Number(bid.bidAmmount || 0).toLocaleString() %></td>
                            <td>
                              <% if (project.status === 'open') { %>
                                <form action="/client/assign-work" method="POST">
                                  <input type="hidden" name="projectId" value="<%= project.id %>">
                                  <input type="hidden" name="freelancerId" value="<%= bid.userId %>">
                                  <button class="assign-btn" type="submit">Assign</button>
                                </form>
                              <% } %>
                            </td>
                          </tr>
                        <% }); %>
                      <% } else { %>
                        <tr>
                          <td colspan="4">No bids yet for this project.</td>
                        </tr>
                      <% } %>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
            <% }) %>
            <!-- End project cards -->

          </div>
        </div><!-- End Left side columns -->

        <!-- Right side columns -->
        <div class="col-lg-4">

          <!-- All Projects -->
          <div class="card">

            <div class="card-body">
              <h5 class="card-title">All Projects</h5>
              <% if (projects.length === 0) { %>
                <p class="text-muted mb-0">Nothing here yet.</p>
              <% } else { %>
                <ul class="project-list">
                  <li class="project-header">
                    <span class="project-title">Title</span>
                    <span class="project-budget">Budget (₹)</span>
                  </li>
                  <% projects.forEach((project) => { %>
                    <li class="project-item">
                      <span class="project-title"><%= project.title %></span>
                      <span class="project-budget"><%= Number(project.budget || 0).toLocaleString() %></span>
                    </li>
                  <% }) %>
                </ul>
              <% } %>
            </div>

          </div><!-- End Recent Activity -->

        </div><!-- End Right side columns -->

      </div>
    </section>

  </main><!-- End #main -->

  <!-- ======= Footer ======= -->
  <footer id="footer" class="footer">
    <div class="copyright">
      &copy; Copyright <strong><span>GigmaPro</span></strong>. All Rights Reserved
    </div>
  </footer><!-- End Footer -->

  <a href="#" class="back-to-top d-flex align-items-center justify-content-center"><i class="bi bi-arrow-up-short"></i></a>

  <!-- Vendor JS Files -->
  <script src="/assets-dashboard/vendor/apexcharts/apexcharts.min.js"></script>
  <script src="/assets-dashboard/vendor/bootstrap/js/bootstrap.bundle.min.js"></script>
  <script src="/assets-dashboard/vendor/chart.js/chart.umd.js"></script>
  <script src="/assets-dashboard/vendor/echarts/echarts.min.js"></script>
  <script src="/assets-dashboard/vendor/quill/quill.js"></script>
  <script src="/assets-dashboard/vendor/simple-datatables/simple-datatables.js"></script>
  <script src="/assets-dashboard/vendor/tinymce/tinymce.min.js"></script>
  <script src="/assets-dashboard/vendor/php-email-form/validate.js"></script>

  <!-- Template Main JS File -->
  <script src="/assets-dashboard/js/main.js"></script>

</body>

</html>
